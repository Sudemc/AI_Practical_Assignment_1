import random

# Generate 5 random numbers between 30000 and 50000
numbers = [random.randint(30000, 50000) for _ in range(5)]

print("Generated numbers:")
for i, num in enumerate(numbers):
    print(f"{i+1}. {num}")

# Player chooses a starting number
choice = int(input("Choose a number (1-5): "))
current_number = numbers[choice - 1]

total_score = 0
bank = 0
player = 1

print("\nStarting number:", current_number)

# Function to check if any valid move exists
def can_divide(n):
    return (n % 2 == 0 or n % 3 == 0 or n % 4 == 0 or n % 5 == 0)

# Game loop
while can_divide(current_number):

    print("\nCurrent number:", current_number)
    print("Total score:", total_score)
    print("Bank:", bank)
    print(f"Player {player}'s turn")

    divisor = int(input("Choose divisor (2,3,4,5): "))

    if divisor not in [2,3,4,5]:
        print("Invalid divisor. Try again.")
        continue

    if current_number % divisor != 0:
        print("Cannot divide evenly. Try again.")
        continue

    # Perform division
    current_number = current_number // divisor
    print("Result:", current_number)

    # Score rule
    if current_number % 2 == 1:
        total_score += 1
        print("Odd result → +1 point")
    else:
        total_score -= 1
        print("Even result → -1 point")

    # Bank rule
    if current_number % 10 == 0 or current_number % 10 == 5:
        bank += 1
        print("Number ends with 0 or 5 → +1 bank point")

    # Switch player
    player = 2 if player == 1 else 1

# Final calculation
print("\nNo more possible moves!")
print("Score before bank:", total_score)
print("Bank points:", bank)

if total_score % 2 == 1:
    total_score -= bank
else:
    total_score += bank

print("Final score:", total_score)

# Determine winner
if total_score % 2 == 1:
    print("Player 1 (starting player) wins!")
else:
    print("Player 2 wins!")
