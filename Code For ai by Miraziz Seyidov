import random
import tkinter as tk
from tkinter import messagebox


class NumberDivisionGame:
    def __init__(self, root):
        self.root = root
        self.root.title("Number Division Game")
        self.root.geometry("700x600")
        self.root.resizable(False, False)

        self.numbers = []
        self.current_number = None
        self.total_score = 0
        self.bank = 0
        self.player = 1
        self.game_started = False

        self.create_widgets()
        self.generate_numbers()

    def create_widgets(self):
        title = tk.Label(
            self.root,
            text="Number Division Game",
            font=("Arial", 20, "bold")
        )
        title.pack(pady=10)

        rules_text = (
            "Rules:\n"
            "1. Choose one of 5 random numbers.\n"
            "2. Players take turns dividing by 2, 3, 4, or 5.\n"
            "3. Division is allowed only if the result is a whole number.\n"
            "4. Odd result = +1 point, Even result = -1 point.\n"
            "5. If the result ends with 0 or 5, bank +1.\n"
            "6. When no moves remain:\n"
            "   - if score is odd -> subtract bank\n"
            "   - if score is even -> add bank\n"
            "7. Final odd score -> Player 1 wins, Final even score -> Player 2 wins."
        )

        self.rules_label = tk.Label(
            self.root,
            text=rules_text,
            justify="left",
            font=("Arial", 10),
            anchor="w"
        )
        self.rules_label.pack(pady=5)

        # Frame for generated numbers
        self.numbers_frame = tk.LabelFrame(
            self.root,
            text="Choose Starting Number",
            font=("Arial", 12, "bold"),
            padx=10,
            pady=10
        )
        self.numbers_frame.pack(pady=10)

        self.number_buttons = []

        # Info frame
        self.info_frame = tk.Frame(self.root)
        self.info_frame.pack(pady=10)

        self.current_number_label = tk.Label(
            self.info_frame, text="Current Number: -", font=("Arial", 12, "bold")
        )
        self.current_number_label.grid(row=0, column=0, padx=20, pady=5)

        self.score_label = tk.Label(
            self.info_frame, text="Total Score: 0", font=("Arial", 12)
        )
        self.score_label.grid(row=0, column=1, padx=20, pady=5)

        self.bank_label = tk.Label(
            self.info_frame, text="Bank: 0", font=("Arial", 12)
        )
        self.bank_label.grid(row=1, column=0, padx=20, pady=5)

        self.player_label = tk.Label(
            self.info_frame, text="Current Player: Player 1", font=("Arial", 12)
        )
        self.player_label.grid(row=1, column=1, padx=20, pady=5)

        # Divisor buttons
        self.divisor_frame = tk.LabelFrame(
            self.root,
            text="Choose Divisor",
            font=("Arial", 12, "bold"),
            padx=10,
            pady=10
        )
        self.divisor_frame.pack(pady=10)

        self.divisor_buttons = []
        for divisor in [2, 3, 4, 5]:
            btn = tk.Button(
                self.divisor_frame,
                text=f"Divide by {divisor}",
                font=("Arial", 11),
                width=12,
                state="disabled",
                command=lambda d=divisor: self.make_move(d)
            )
            btn.pack(side="left", padx=10, pady=5)
            self.divisor_buttons.append(btn)

        # Log area
        self.log_frame = tk.LabelFrame(
            self.root,
            text="Game Log",
            font=("Arial", 12, "bold"),
            padx=10,
            pady=10
        )
        self.log_frame.pack(pady=10, fill="both", expand=True, padx=20)

        self.log_text = tk.Text(self.log_frame, height=12, width=75, state="disabled")
        self.log_text.pack()

        # Control buttons
        self.control_frame = tk.Frame(self.root)
        self.control_frame.pack(pady=10)

        self.new_game_button = tk.Button(
            self.control_frame,
            text="New Game",
            font=("Arial", 11, "bold"),
            width=12,
            command=self.reset_game
        )
        self.new_game_button.pack(side="left", padx=10)

        self.exit_button = tk.Button(
            self.control_frame,
            text="Exit",
            font=("Arial", 11, "bold"),
            width=12,
            command=self.root.quit
        )
        self.exit_button.pack(side="left", padx=10)

    def log(self, message):
        self.log_text.config(state="normal")
        self.log_text.insert(tk.END, message + "\n")
        self.log_text.see(tk.END)
        self.log_text.config(state="disabled")

    def generate_numbers(self):
        for widget in self.numbers_frame.winfo_children():
            widget.destroy()

        self.numbers = [random.randint(30000, 50000) for _ in range(5)]
        self.number_buttons.clear()

        for i, num in enumerate(self.numbers):
            btn = tk.Button(
                self.numbers_frame,
                text=str(num),
                font=("Arial", 11),
                width=12,
                command=lambda n=num: self.choose_starting_number(n)
            )
            btn.grid(row=0, column=i, padx=5, pady=5)
            self.number_buttons.append(btn)

    def choose_starting_number(self, number):
        if self.game_started:
            return

        self.current_number = number
        self.total_score = 0
        self.bank = 0
        self.player = 1
        self.game_started = True

        for btn in self.number_buttons:
            btn.config(state="disabled")

        for btn in self.divisor_buttons:
            btn.config(state="normal")

        self.update_labels()
        self.log(f"Starting number chosen: {self.current_number}")
        self.log("Game started. Player 1 moves first.")

        if not self.can_divide(self.current_number):
            self.end_game()

    def can_divide(self, n):
        return n % 2 == 0 or n % 3 == 0 or n % 4 == 0 or n % 5 == 0

    def make_move(self, divisor):
        if not self.game_started:
            return

        if self.current_number % divisor != 0:
            messagebox.showwarning(
                "Invalid Move",
                f"{self.current_number} cannot be divided evenly by {divisor}."
            )
            return

        previous_player = self.player
        self.current_number //= divisor
        self.log(f"Player {previous_player} divided by {divisor}. Result: {self.current_number}")

        # Score rule
        if self.current_number % 2 == 1:
            self.total_score += 1
            self.log("Result is odd -> +1 point")
        else:
            self.total_score -= 1
            self.log("Result is even -> -1 point")

        # Bank rule
        if self.current_number % 10 == 0 or self.current_number % 10 == 5:
            self.bank += 1
            self.log("Result ends with 0 or 5 -> +1 bank point")

        # Change player
        self.player = 2 if self.player == 1 else 1

        self.update_labels()

        if not self.can_divide(self.current_number):
            self.end_game()

    def update_labels(self):
        self.current_number_label.config(text=f"Current Number: {self.current_number}")
        self.score_label.config(text=f"Total Score: {self.total_score}")
        self.bank_label.config(text=f"Bank: {self.bank}")
        self.player_label.config(text=f"Current Player: Player {self.player}")

    def end_game(self):
        self.log("No more possible moves.")
        self.log(f"Score before bank: {self.total_score}")
        self.log(f"Bank points: {self.bank}")

        final_score = self.total_score
        if final_score % 2 == 1:
            final_score -= self.bank
            self.log("Score is odd -> subtracting bank points")
        else:
            final_score += self.bank
            self.log("Score is even -> adding bank points")

        self.log(f"Final score: {final_score}")

        if final_score % 2 == 1:
            winner = "Player 1 wins!"
        else:
            winner = "Player 2 wins!"

        self.log(winner)
        messagebox.showinfo("Game Over", f"Final score: {final_score}\n{winner}")

        self.game_started = False
        for btn in self.divisor_buttons:
            btn.config(state="disabled")

    def reset_game(self):
        self.current_number = None
        self.total_score = 0
        self.bank = 0
        self.player = 1
        self.game_started = False

        self.current_number_label.config(text="Current Number: -")
        self.score_label.config(text="Total Score: 0")
        self.bank_label.config(text="Bank: 0")
        self.player_label.config(text="Current Player: Player 1")

        self.log_text.config(state="normal")
        self.log_text.delete(1.0, tk.END)
        self.log_text.config(state="disabled")

        for btn in self.divisor_buttons:
            btn.config(state="disabled")

        self.generate_numbers()
        self.log("New game started. Choose a starting number.")


if __name__ == "__main__":
    root = tk.Tk()
    app = NumberDivisionGame(root)
    root.mainloop()
